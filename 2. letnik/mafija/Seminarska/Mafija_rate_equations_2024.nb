  3.924752959634268*^9}},ExpressionUUID->"45d38ed4-087e-49ef-9b6d-\
b429f523ca99"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"funlaser", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "alfa"}], " ", "F"}], " ", "+", " ", 
     RowBox[{"gama", "  ", "a", " ", "F"}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "beta"}], " ", "a"}], " ", "-", " ", 
     RowBox[{"delta", " ", "a", " ", "F"}], " ", "+", " ", "R"}]}], 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.892716549162057*^9, 3.8927165948088303`*^9}, {
