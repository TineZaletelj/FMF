Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", "alfa"}], " ", "F"}], "+", 
    RowBox[{"a", " ", "F", " ", "gama"}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "a"}], " ", "beta"}], "-", 
    RowBox[{"a", " ", "delta", " ", "F"}], "+", "R"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.892716587349618*^9, 3.892716595562038*^9}, 
