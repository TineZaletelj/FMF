Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "tempfunction", ",", "gp", ",", "gg", ",", "sp", ",", "os", ",", 
       "nsl"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tempfunction", ":=", 
       RowBox[{"ff", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"N0", "->", "1"}], ",", 
          RowBox[{"a", "->", "aaa"}], ",", 
          RowBox[{"b", "->", "bbb"}], ",", 
          RowBox[{"g", "->", "ggg"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nsl", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"BB", "[", "t", "]"}], ",", 
          RowBox[{"DD", "[", "t", "]"}]}], "}"}], "/.", 
        RowBox[{
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"BB", "'"}], "[", "t", "]"}], "==", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "bbb"}], " ", 
                RowBox[{"BB", "[", "t", "]"}]}], "+", 
               RowBox[{"aaa", " ", 
                RowBox[{"BB", "[", "t", "]"}], 
                RowBox[{"DD", "[", "t", "]"}]}]}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"DD", "'"}], "[", "t", "]"}], "==", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "aaa"}], " ", 
                RowBox[{"BB", "[", "t", "]"}], 
                RowBox[{"DD", "[", "t", "]"}]}], "+", 
               RowBox[{"ggg", 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"DD", "[", "t", "]"}], "-", 
                  RowBox[{"BB", "[", "t", "]"}]}], ")"}]}]}]}], ",", 
             RowBox[{
              RowBox[{"DD", "[", "0", "]"}], "==", "0.99"}], ",", 
             RowBox[{
              RowBox[{"BB", "[", "0", "]"}], "==", "0.01"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"BB", "[", "t", "]"}], ",", 
             RowBox[{"DD", "[", "t", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"gp", "=", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"BB", ",", "DD"}], "}"}], "/.", "sol"}], ")"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"N0", "->", "1"}], ",", 
           RowBox[{"a", "->", "aaa"}], ",", 
           RowBox[{"b", "->", "bbb"}], ",", 
           RowBox[{"g", "->", "ggg"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gg", "=", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{"Black", ",", 
          RowBox[{"Opacity", "[", "0.5", "]"}], ",", 
          RowBox[{"Polygon", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
