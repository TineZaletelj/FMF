Cell[BoxData[
 RowBox[{
  RowBox[{"w", "[", 
   RowBox[{"x_", ",", "a_", ",", "\[Beta]_"}], "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"a", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "x", " ", "\[Beta]"}]]}], "+", 
    FractionBox["k", 
     RowBox[{"4", " ", 
      SuperscriptBox["\[Beta]", "2"]}]], "-", 
    FractionBox[
     RowBox[{"k", " ", "x"}], 
     RowBox[{"2", " ", "\[Beta]"}]]}], "/.", 
   RowBox[{"k", "->", "1"}]}]}]], "Input",
