}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"resitev", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"Thread", "[", 
     RowBox[{"funlaser", "==", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], "]"}], ",", 
